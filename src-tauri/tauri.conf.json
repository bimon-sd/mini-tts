{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mini TTS",
  "version": "1.0.1",
  "identifier": "com.greader.app",
  "build": {
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mini TTS",
        "width": 850,
        "height": 520,
        "minWidth": 600,
        "minHeight": 400,
        "maxWidth": 850,
        "maxHeight": 520,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "python": "python",
      "../README.md": "README.md",
      "ffmpeg.exe": "ffmpeg.exe"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
